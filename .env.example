# ===== 控制面 =====
DATABASE_URL=postgresql+asyncpg://etl:etl@postgresql:5432/etlagent
REDIS_URL=redis://redis:6379/0

# ===== 本地 Secret Vault（AES-256-GCM 信封加密，按 Vault KV v2 接口抽象，D1）=====
# 32 字节 base64；生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_MASTER_KEY=

# ===== LLM（OpenAI 兼容协议，全配置化 D6，代码不硬编码模型名）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ID=

# ===== 数据面 =====
SEATUNNEL_URL=http://seatunnel:5801
DORIS_HOST=doris-fe
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=doris123
DORIS_DATABASE=ods
DORIS_DRYRUN_DATABASE=tmp_dry_run

# ===== MinIO（CSV 文件资产，C3）=====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=etl-assets
